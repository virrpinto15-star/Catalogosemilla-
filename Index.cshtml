@model List<CatalogoPapa.Models.Producto>

@{
    ViewData["Title"] = "Catálogo - Semilla de Vida";
    var categorias = ViewBag.Categorias as List<CatalogoPapa.Models.Categoria>;
    int? categoriaSeleccionada = ViewBag.CategoriaSeleccionada;
    string? buscar = ViewBag.Buscar as string;
}

<style>
    .product-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        border-radius: 12px;
        overflow: hidden;
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1) !important;
    }
    .product-img-container {
        height: 190px;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
    }
    .product-img-container img {
        max-height: 170px;
        max-width: 100%;
        object-fit: contain;
    }
</style>

<div class="mb-4">
    <div class="row align-items-center mb-3">
        <div class="col-md-6">
            <h1 class="fw-bold mb-1">🌿 Catálogo Semilla de Vida</h1>
            <p class="text-muted mb-2">Explora nuestra selección de productos frescos y naturales.</p>
        </div>
        <div class="col-md-6">
            <form method="get" asp-action="Index" class="d-flex">
                @if (categoriaSeleccionada.HasValue)
                {
                    <input type="hidden" name="categoriaId" value="@categoriaSeleccionada.Value" />
                }
                <div class="input-group">
                    <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Buscar producto..." />
                    <button class="btn btn-success" type="submit">🔍 Buscar</button>
                    @if (!string.IsNullOrEmpty(buscar) || categoriaSeleccionada.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">✕ Limpiar</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Filtros de categoría -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-action="Index" asp-route-buscar="@buscar"
           class="btn @(categoriaSeleccionada == null ? "btn-success" : "btn-outline-success") btn-sm rounded-pill px-3">
            Todos
        </a>
        @if (categorias != null)
        {
            foreach (var cat in categorias)
            {
                <a asp-action="Index" asp-route-categoriaId="@cat.Id" asp-route-buscar="@buscar"
                   class="btn @(categoriaSeleccionada == cat.Id ? "btn-success" : "btn-outline-success") btn-sm rounded-pill px-3">
                    @cat.Nombre
                </a>
            }
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-5 shadow-sm rounded-3">
        <span class="fs-1">🔍</span>
        <h4 class="mt-3">No se encontraron productos</h4>
        <p class="text-muted">Intenta con otros términos de búsqueda o revisa otra categoría.</p>
        <a asp-action="Index" class="btn btn-outline-success">Ver todos los productos</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var producto in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 product-card">
                    <div class="product-img-container">
                        @if (!string.IsNullOrEmpty(producto.Imagen))
                        {
                            <img src="~/images/@producto.Imagen"
                                 alt="@producto.Nombre"
                                 onerror="this.onerror=null; this.src='https://placehold.co/200x200?text=@Uri.EscapeDataString(producto.Nombre)';" />
                        }
                        else
                        {
                            <span class="text-muted fs-1">📦</span>
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-light text-dark border">
                                @(producto.Categoria?.Nombre ?? "General")
                            </span>
                            @if (producto.Stock > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    Stock: @producto.Stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Agotado</span>
                            }
                        </div>

                        <h5 class="card-title fw-bold text-dark mb-1">@producto.Nombre</h5>
                        <p class="card-text text-muted small flex-grow-1">@producto.Descripcion</p>

                        <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold text-success">$@producto.Precio.ToString("N2")</span>

                            @if (producto.Stock > 0)
                            {
                                <form asp-controller="Carrito" asp-action="Agregar" method="post" class="m-0">
                                    <input type="hidden" name="id" value="@producto.Id" />
                                    <button type="submit" class="btn btn-success btn-sm px-3 shadow-sm">
                                        🛒 Agregar
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm px-3" disabled>
                                    Agotado
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

