@model CatalogoPapa.Models.Producto

@{
    ViewData["Title"] = "Editar Producto - Semilla de Vida";
    var categorias = ViewBag.Categorias as List<CatalogoPapa.Models.Categoria>;
}

<div class="container py-3" style="max-width: 700px;">
    <div class="mb-4">
        <a asp-action="Admin" class="text-decoration-none text-muted">
            ← Volver a la lista de productos
        </a>
        <h1 class="h2 fw-bold text-dark mt-2">✏️ Editar Producto</h1>
        <p class="text-muted">Modifica precio, stock, descripción o actualiza la foto de @Model.Nombre.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <form asp-action="Editar" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-bold">Nombre del Producto *</label>
                <input asp-for="Nombre" class="form-control form-control-lg" required />
            </div>

            <div class="mb-3">
                <label asp-for="CategoriaId" class="form-label fw-bold">Categoría *</label>
                <select asp-for="CategoriaId" class="form-select form-select-lg" required>
                    @if (categorias != null)
                    {
                        foreach (var cat in categorias)
                        {
                            <option value="@cat.Id" selected="@(cat.Id == Model.CategoriaId ? "selected" : null)">
                                @cat.Nombre
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Precio" class="form-label fw-bold">Precio ($) *</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text">$</span>
                        <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="Stock" class="form-label fw-bold">Stock Disponible *</label>
                    <input asp-for="Stock" type="number" min="0" class="form-control form-control-lg" required />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label fw-bold">Descripción (opcional)</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Foto del Producto</label>
                
                @if (!string.IsNullOrEmpty(Model.Imagen))
                {
                    <div class="mb-2 p-2 border rounded bg-light d-flex align-items-center gap-3">
                        <img src="~/images/@Model.Imagen" alt="@Model.Nombre" class="rounded" style="width: 70px; height: 70px; object-fit: contain; background: white;" />
                        <div>
                            <span class="badge bg-secondary mb-1">Imagen actual</span>
                            <div class="small text-muted">@Model.Imagen</div>
                            <small class="text-muted">Si no subes una nueva foto, se conservará esta.</small>
                        </div>
                    </div>
                }

                <label class="form-label small text-muted">Cambiar foto (opcional):</label>
                <input type="file" name="archivoImagen" id="inputImagen" class="form-control" accept="image/*" />

                <!-- Vista previa de nueva imagen -->
                <div id="contenedorPreview" class="mt-3 text-center d-none">
                    <p class="small text-success fw-bold mb-1">Nueva imagen seleccionada:</p>
                    <img id="imgPreview" src="#" alt="Nueva vista previa" class="rounded shadow-sm border p-1" style="max-height: 180px; max-width: 100%; object-fit: contain;" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                <a asp-action="Admin" class="btn btn-outline-secondary btn-lg px-4">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-success btn-lg px-4 shadow-sm">
                    💾 Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const inputImagen = document.getElementById('inputImagen');
        const imgPreview = document.getElementById('imgPreview');
        const contenedorPreview = document.getElementById('contenedorPreview');

        inputImagen.addEventListener('change', function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imgPreview.src = e.target.result;
                    contenedorPreview.classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            } else {
                contenedorPreview.classList.add('d-none');
            }
        });
    </script>
}

