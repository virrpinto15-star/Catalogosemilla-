@using Microsoft.AspNetCore.Http
@using System.Text.Json
@{
    var carritoJson = Context.Session.GetString("Carrito");
    var totalArticulos = 0;
    if (!string.IsNullOrEmpty(carritoJson))
    {
        var carrito = JsonSerializer.Deserialize<List<CatalogoPapa.Models.CarritoItem>>(carritoJson);
        totalArticulos = carrito?.Sum(x => x.Cantidad) ?? 0;
    }
    var esAdmin = Context.Session.GetString("AdminLogueado") == "true";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Semilla de Vida</title>
    <script type="importmap"></script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌱</text></svg>">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CatalogoPapa.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Barra superior de anuncios -->
    <div class="py-2 text-center text-white small" style="background-color: var(--color-forest-dark); letter-spacing: 0.3px;">
        <div class="container d-flex justify-content-center align-items-center flex-wrap gap-2">
            <span>
                🚚 <strong>Envíos coordinados</strong> • Pedidos por WhatsApp al 
                <a href="https://wa.me/5493518008605" class="text-white text-decoration-underline fw-bold" target="_blank">351 800-8605</a> • Calidad 100% Natural 🌱
            </span>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold brand-name d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="me-2">🌱</span> Semilla de Vida
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Producto" asp-action="Index">Catálogo</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        <li class="nav-item">
                            <a class="btn btn-outline-success position-relative" asp-area="" asp-controller="Carrito" asp-action="Index">
                                🛒 Carrito
                                @if (totalArticulos > 0)
                                {
                                    <span class="badge bg-danger rounded-pill ms-1">@totalArticulos</span>
                                }
                            </a>
                        </li>
                        @if (esAdmin)
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-secondary btn-sm" asp-controller="Producto" asp-action="Admin">⚙️ Admin</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Admin" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Pie de página comercial completo -->
    <footer class="footer mt-5 pt-5 pb-4 bg-white border-top shadow-sm">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6 pe-lg-4">
                    <h5 class="fw-bold brand-name mb-3">🌱 Semilla de Vida</h5>
                    <p class="text-muted small mb-3" style="line-height: 1.6;">
                        Alimentos naturales, frutos secos seleccionados, yerbas, condimentos y frascos. Compromiso y calidad para acompañar tu alimentación consciente.
                    </p>
                    <div class="small text-muted">
                        <span>📍 Entregas y envíos coordinados a domicilio</span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Enlaces rápidos</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                        <li class="mb-2"><a asp-controller="Producto" asp-action="Index" class="text-decoration-none text-muted">Catálogo Completo</a></li>
                        <li class="mb-2"><a asp-controller="Carrito" asp-action="Index" class="text-decoration-none text-muted">Mi Carrito</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Contacto & Pedidos</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2">
                            <a href="https://wa.me/5493518008605" target="_blank" class="text-decoration-none text-success fw-bold">
                                📲 WhatsApp: 351 800-8605
                            </a>
                        </li>
                        <li class="text-muted mb-2">🕒 Lunes a Sábados: 9:00 a 19:00 hs</li>
                        <li class="text-muted">💬 Consultas y presupuestos online</li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Medios de Pago</h6>
                    <div class="d-flex flex-column gap-2 small">
                        <span class="badge bg-light text-dark border p-2 text-start fw-normal">💵 Efectivo al recibir</span>
                        <span class="badge bg-light text-dark border p-2 text-start fw-normal">🏦 Transferencia</span>
                        <span class="badge bg-light text-dark border p-2 text-start fw-normal">💳 Mercado Pago</span>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 small text-muted">
                <div>&copy; 2026 - <strong class="text-success">Semilla de Vida</strong>. Todos los derechos reservados.</div>
                <div>Alimentación consciente y vida sana 🌱</div>
            </div>
        </div>
    </footer>

    <!-- Botón Flotante de WhatsApp -->
    <a href="https://wa.me/5493518008605?text=Hola%20Semilla%20de%20Vida!%20Quiero%20hacerles%20una%20consulta." 
       target="_blank" 
       class="btn-whatsapp-flotante" 
       title="Chatear por WhatsApp">
        <span class="whatsapp-badge d-none d-md-inline">¿Tenés dudas? Chateá acá</span>
        <div class="whatsapp-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="white" viewBox="0 0 16 16">
                <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.016-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
            </svg>
        </div>
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
